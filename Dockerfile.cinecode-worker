FROM node:22-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    AI_OS_CINECODE_STORAGE_DIR=/data/cinecode \
    CINECODE_SOURCE_DIR=/opt/cinecode \
    CODEX_HOME=/codex

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv ffmpeg git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && npm install --global @openai/codex@0.169.0 \
    && codex --version \
    && codex exec --help > /tmp/codex-exec-help \
    && for flag in --sandbox --ignore-user-config --ephemeral --json --output-last-message --skip-git-repo-check --cd; do grep -q -- "$flag" /tmp/codex-exec-help || exit 1; done \
    && rm -f /tmp/codex-exec-help \
    && useradd --create-home --uid 10001 aios \
    && mkdir -p /data/cinecode /codex /opt/cinecode \
    && chown -R aios:aios /data/cinecode /codex /home/aios

ENV PATH=/opt/venv/bin:$PATH
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

USER 10001:10001
VOLUME ["/data/cinecode", "/codex", "/opt/cinecode"]
CMD ["python", "-m", "ai_os.cinecode_worker"]
