# Local development defaults
AI_OS_ENV=development
AI_OS_DATABASE_URL=sqlite:///./ai_os.db

# Required for staging/production. Generate a long random value and set it
# as a private environment variable in the hosting dashboard. Never commit it.
AI_OS_API_KEY=

# Optional free-tier model providers. Add keys only in your private host
# environment settings; never commit real keys or paste them into GitHub.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
