AI_OS_ENV=development
AI_OS_DATABASE_URL=sqlite:///./ai_os.db

# Canonical owner token for protected APIs (at least 32 random characters)
AI_OS_API_TOKEN=
# Optional compatibility alias (ignored when AI_OS_API_TOKEN is set)
AI_OS_API_KEY=

# Optional WordPress read-only connector (keep real values out of Git)
AI_OS_WORDPRESS_URL=
AI_OS_WORDPRESS_USERNAME=
AI_OS_WORDPRESS_APPLICATION_PASSWORD=
# Optional WordPress draft creation (requires owner approval per exact draft)
# Keep these secrets on the private runtime host only.
AI_OS_WORDPRESS_DRAFT_WRITES_ENABLED=false
AI_OS_EXTERNAL_ACTIONS_ENABLED=false
# Optional WooCommerce product draft creation (owner approval required)
AI_OS_WOOCOMMERCE_DRAFT_WRITES_ENABLED=false

# Optional metered web research (disabled by default; owner must approve costs)
AI_OS_RESEARCH_ENABLED=false
EXA_API_KEY=

# Optional specialist model execution (disabled by default; provider may be metered)
AI_OS_MODEL_ENABLED=false
AI_OS_MODEL_BACKEND=openai_compatible
AI_OS_MODEL_BASE_URL=
AI_OS_MODEL_NAME=
AI_OS_MODEL_API_KEY=
# Agent tool calls are separately disabled; enabling the model does not enable tools.
AI_OS_AGENT_TOOL_CALLS_ENABLED=false

# Optional WooCommerce read-only connector (credentials stay on the private runtime)
AI_OS_WOOCOMMERCE_URL=
AI_OS_WOOCOMMERCE_CONSUMER_KEY=
AI_OS_WOOCOMMERCE_CONSUMER_SECRET=
