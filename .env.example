# Local development defaults
AI_OS_ENV=development
AI_OS_DATABASE_URL=sqlite:///./ai_os.db

# Required for staging/production. Generate a long random value and set it
# as a private environment variable in the hosting dashboard. Never commit it.
AI_OS_API_KEY=

# Optional OpenAI-compatible model endpoint. Disabled by default.
# Configure only after checking the provider's current free-tier terms and quotas.
AI_OS_MODEL_ENABLED=false
AI_OS_MODEL_PROVIDER=custom
AI_OS_MODEL_BASE_URL=
AI_OS_MODEL_NAME=
AI_OS_MODEL_API_KEY=
AI_OS_MODEL_TIMEOUT_SECONDS=30
AI_OS_MODEL_MAX_TOKENS=512
