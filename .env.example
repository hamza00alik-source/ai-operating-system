# OpenCompany AIOS — local development starter
# Copy values into your shell or your hosting provider's private variable store.
# Never commit real credentials or secrets.

# Required owner authentication secret. Use a long, random value.
OPENCOMPANY_OWNER_API_KEY=

# Required independent encryption key for stored provider credentials.
# Use a separate random value (at least 32 characters); back it up securely.
OPENCOMPANY_SECRET_ENCRYPTION_KEY=

# Local database path. For Railway, use a persistent volume such as /data.
OPENCOMPANY_DATABASE_PATH=./opencompany_core.sqlite3

# Set false only for local HTTP development. Set true behind HTTPS in hosting.
OPENCOMPANY_COOKIE_SECURE=false

# Worker autostart is opt-in and requires a successful owner provider test.
OPENCOMPANY_WORKER_AUTOSTART=false

# Optional first-start provisioning and autonomous queue controls.
# Keep all disabled until the owner has reviewed the workforce and approval flow.
OPENCOMPANY_BOOTSTRAP_WORKFORCE=false
OPENCOMPANY_AUTO_ACTIVATE_WORKFORCE=false
OPENCOMPANY_AUTO_QUEUE_APPROVED_WORK=false

# Worker reliability/concurrency tuning; defaults shown.
OPENCOMPANY_WORKER_MAX_ATTEMPTS=3
OPENCOMPANY_WORKER_LEASE_SECONDS=300
OPENCOMPANY_WORKER_CONCURRENCY=2
OPENCOMPANY_WORKER_IDLE_SECONDS=2

# Optional UnoRouter provider. Keep disabled until owner verifies account access,
# zero pricing, terms, privacy and business-use eligibility.
OPENCOMPANY_UNOROUTER_API_KEY=
OPENCOMPANY_UNOROUTER_FREE_MODEL=
OPENCOMPANY_CONFIRM_UNOROUTER_FREE=false

# Optional read-only API Anything research connector.
OPENCOMPANY_API_ANYTHING_BASE_URL=
OPENCOMPANY_API_ANYTHING_TOKEN=

# Optional owner-approved GitHub draft-PR code evolution integration.
OPENCOMPANY_GITHUB_TOKEN=
OPENCOMPANY_GITHUB_REPOSITORY=hamza00alik-source/ai-operating-system
OPENCOMPANY_GITHUB_BASE_BRANCH=feature/opencompany-aios-unification
