# Local development defaults
AI_OS_ENV=development
AI_OS_DATABASE_URL=sqlite:///./ai_os.db

# Required for staging/production. Generate a long random value and set it
# as a private environment variable in the hosting dashboard. Never commit it.
AI_OS_API_KEY=


# Optional live LLM provider configuration.
# Keep all values private in the hosting provider's environment-variable panel.
# A provider is blocked unless all three connection values are set and the
# FREE_CONFIRMED flag is explicitly set to true after checking current terms.
# Never set FREE_CONFIRMED=true for a trial-credit-only or paid endpoint.

AI_OS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_OS_GEMINI_MODEL=
AI_OS_GEMINI_API_KEY=
AI_OS_GEMINI_FREE_CONFIRMED=false

# OpenRouter: choose a currently available :free model in your OpenRouter account.
AI_OS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_OS_OPENROUTER_MODEL=
AI_OS_OPENROUTER_API_KEY=
AI_OS_OPENROUTER_FREE_CONFIRMED=false
AI_OS_OPENROUTER_REFERER=https://github.com/hamza00alik-source/ai-operating-system

AI_OS_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_OS_GROQ_MODEL=
AI_OS_GROQ_API_KEY=
AI_OS_GROQ_FREE_CONFIRMED=false

AI_OS_MISTRAL_BASE_URL=https://api.mistral.ai/v1
AI_OS_MISTRAL_MODEL=
AI_OS_MISTRAL_API_KEY=
AI_OS_MISTRAL_FREE_CONFIRMED=false

# Cloudflare base URL must include your account ID and /ai/run.
AI_OS_CLOUDFLARE_BASE_URL=
AI_OS_CLOUDFLARE_MODEL=
AI_OS_CLOUDFLARE_API_TOKEN=
AI_OS_CLOUDFLARE_FREE_CONFIRMED=false

# Optional custom OpenAI-compatible endpoint. Paid endpoints remain blocked
# unless an owner explicitly marks them free after checking provider terms.
AI_OS_CUSTOM_BASE_URL=
AI_OS_CUSTOM_MODEL=
AI_OS_CUSTOM_API_KEY=
AI_OS_CUSTOM_FREE_CONFIRMED=false
