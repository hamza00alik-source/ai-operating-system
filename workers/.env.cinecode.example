# Copy to workers/.env.cinecode and fill with values from your secret manager.
AIOS_API_URL=https://YOUR-AIOS-API-ORIGIN
VIDEO_CINECODE_WORKER_TOKEN=REPLACE_WITH_A_UNIQUE_PROVIDER_SECRET
VIDEO_WORKER_ID=cinecode-linux-workstation-01
VIDEO_POLL_SECONDS=5
VIDEO_LEASE_SECONDS=120
VIDEO_HEARTBEAT_SECONDS=15
CINECODE_JOB_TIMEOUT_SECONDS=3600
CINECODE_MAX_DURATION_SECONDS=900
CINECODE_MAX_ARTIFACT_BYTES=314572800
CINECODE_EXECUTION_ENABLED=false
CINECODE_BILLING_CONFIRMED=false
