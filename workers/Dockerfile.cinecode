# syntax=docker/dockerfile:1
# Dedicated Linux workstation worker. Build with an explicitly pinned Codex CLI version.
FROM node:22-bookworm-slim

ARG CINECODE_COMMIT=c8a3e7552699360a2b0142c9620882af2069eedb
ARG CODEX_VERSION=0.169.0
RUN test -n "$CODEX_VERSION" || (echo "CODEX_VERSION build argument is required" >&2; exit 1)

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHON_BIN=python3 \
    CHROME_BIN=chromium \
    FFPROBE_BIN=ffprobe \
    CODEX_BIN=codex \
    AIOS_ALLOW_INSECURE_HTTP=false \
    CINECODE_EXECUTION_ENABLED=false \
    CINECODE_BILLING_CONFIRMED=false \
    CINECODE_EXPECTED_COMMIT=${CINECODE_COMMIT} \
    CINECODE_SOURCE_DIR=/opt/cinecode-source \
    CINECODE_WORK_ROOT=/var/lib/cinecode-work \
    HOME=/home/cinecode \
    CODEX_HOME=/home/cinecode/.codex

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates chromium ffmpeg git passwd python3 tini \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "@openai/codex@${CODEX_VERSION}" \
    && useradd --system --uid 10001 --create-home --home-dir /home/cinecode --shell /usr/sbin/nologin cinecode \
    && mkdir -p /opt/cinecode-source /opt/aios-worker /var/lib/cinecode-work /home/cinecode/.codex \
    && git -C /opt/cinecode-source init \
    && git -C /opt/cinecode-source remote add origin https://github.com/sarpstar/cinecode.git \
    && git -C /opt/cinecode-source fetch --depth 1 origin "${CINECODE_COMMIT}" \
    && git -C /opt/cinecode-source checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/cinecode-source rev-parse HEAD)" = "${CINECODE_COMMIT}" \
    && chown -R cinecode:cinecode /var/lib/cinecode-work /home/cinecode /opt/aios-worker

WORKDIR /opt/aios-worker
COPY workers/cinecode_worker.py /opt/aios-worker/cinecode_worker.py
RUN python3 -m py_compile /opt/aios-worker/cinecode_worker.py \
    && node --version && python3 --version && chromium --version \
    && ffmpeg -version && ffprobe -version && codex --version \
    && codex exec --help >/tmp/codex-exec-help \
    && python3 -c 'from pathlib import Path; t=Path("/tmp/codex-exec-help").read_text(); required=["--ask-for-approval","--sandbox","--output-last-message","--ignore-user-config","--ephemeral","--skip-git-repo-check"]; missing=[x for x in required if x not in t]; print("Missing Codex CLI flags:", missing); raise SystemExit(bool(missing))' \
    && rm -f /tmp/codex-exec-help \
    && chown -R cinecode:cinecode /opt/aios-worker

USER 10001:10001
VOLUME ["/var/lib/cinecode-work", "/home/cinecode/.codex"]
ENTRYPOINT ["/usr/bin/tini", "--", "python3", "/opt/aios-worker/cinecode_worker.py"]
